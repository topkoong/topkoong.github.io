---
/**
 * Homepage - Personal Portfolio Landing Page
 *
 * This is the main landing page for the personal portfolio website.
 * Features include:
 * - Animated hero section with typing effects
 * - Recent blog posts showcase
 * - Social media links
 * - Responsive design with dark mode support
 * - Floating particle animations
 *
 * @file src/pages/index.astro
 * @author Theeruttop (Top)
 * @version 1.0.0
 */

// Layout and Component Imports
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import GradualSpacing from '../components/GradualSpacing.astro';
import TypingEffect from '../components/TypingEffect.astro';
import StaggeredFade from '../components/StaggeredFade.astro';
import RotateWords from '../components/RotateWords.astro';

/**
 * Frontmatter interface for blog post metadata
 * Defines the structure of frontmatter data extracted from markdown files
 */
interface Frontmatter {
  title: string; // Blog post title
  date: string; // Publication date (ISO format)
  description: string; // Post description/summary
  published?: boolean; // Optional visibility control (defaults to true)
}

/**
 * Markdown module interface
 * Represents the structure of imported markdown files
 */
interface MarkdownModule {
  frontmatter: Frontmatter;
  Content: any; // Astro's compiled markdown content
}

/**
 * Blog Posts Processing Pipeline
 *
 * This section handles the complete blog post processing workflow:
 * 1. Import all markdown files from the blog/posts directory
 * 2. Extract frontmatter and content
 * 3. Generate URL slugs from file paths
 * 4. Filter published posts
 * 5. Sort by date (newest first)
 * 6. Limit to 3 most recent posts for homepage display
 */

// Import all markdown files from blog posts directory
const posts = await Promise.all(
  Object.entries(
    import.meta.glob<{ frontmatter: Frontmatter }>('./blog/posts/*.md')
  ).map(async ([path, resolver]) => {
    const post = await resolver();
    return {
      ...post,
      // Generate clean URL slug from file path
      slug: path.replace('./blog/posts/', '').replace('.md', ''),
    };
  })
);

// Filter posts based on published status
// Posts are published by default unless explicitly set to false
const publishedPosts = posts.filter(
  (post) => post.frontmatter.published !== false
);

// Sort posts chronologically and select the 3 most recent for homepage
const sortedPosts = publishedPosts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime()
  )
  .slice(0, 3);
