---
// Social media preview page
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Toppy's Digital Playground"
  description='Software Engineer sharing insights on full-stack development, automation, and scaling knowledge through practical tutorials and thoughts.'
>
  <div
    class='min-h-screen flex items-center justify-center bg-gradient-to-br from-purple-900 via-blue-900 to-indigo-900'
  >
    <div class='text-center text-white p-8 max-w-4xl'>
      <h1 class='text-6xl font-bold mb-6'>
        <span
          class='bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent'
        >
          Toppy's Digital Playground
        </span>
      </h1>
      <p class='text-2xl mb-8 text-gray-300'>
        Software Engineer. Building the Full Stack, Mastering Automation, and
        Scaling Knowledge.
      </p>
      <div class='flex justify-center space-x-8 text-lg'>
        <span class='px-4 py-2 bg-purple-600 rounded-full'
          >Full-Stack Development</span
        >
        <span class='px-4 py-2 bg-blue-600 rounded-full'>Automation</span>
        <span class='px-4 py-2 bg-pink-600 rounded-full'>Tutorials</span>
      </div>
    </div>
  </div>
</Layout>
