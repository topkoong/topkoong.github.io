---
// Astro component for Rotate Words text animation
export interface Props {
  words: string[];
  className?: string;
  duration?: number;
}

const { words, className = "text-2xl font-semibold", duration = 2 } = Astro.props;
const uniqueId = Math.random().toString(36).substr(2, 9);
---

<div id={`rotate-words-${uniqueId}`} class={className}></div>

<script define:vars={{ words, className, duration, uniqueId }}>
  import React from 'react';
  import { createRoot } from 'react-dom/client';
  import { RotateWords } from '../components/TextAnimations';

  const container = document.getElementById(`rotate-words-${uniqueId}`);
  if (container) {
    const root = createRoot(container);
    root.render(React.createElement(RotateWords, { words, className, duration }));
  }
</script>
