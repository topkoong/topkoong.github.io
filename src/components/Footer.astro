---
/**
 * Footer Component
 * 
 * This component provides the website footer with:
 * - About section with personal description
 * - Navigation links
 * - Social media links (GitHub, X/Twitter)
 * - Copyright information
 * - Responsive grid layout
 * 
 * Features:
 * - Three-column responsive layout
 * - Social media icons with hover effects
 * - Dark/light mode support
 * - Accessible link structure
 * - Dynamic copyright year
 * 
 * @fileoverview Website footer with social links and information
 */

// Get current year for copyright notice
const currentYear = new Date().getFullYear();
---

<!-- 
  Footer Template
  
  This template creates a comprehensive footer with:
  - Three-column responsive grid layout
  - About section with personal description
  - Navigation links
  - Social media links with icons
  - Copyright notice
-->
<footer
  class='border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-black transition-colors duration-200'
>
  <!-- Main footer content container -->
  <div class='max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8'>
    <!-- Three-column responsive grid -->
    <div class='grid grid-cols-1 md:grid-cols-3 gap-8'>
      <!-- About Section -->
      <div>
        <h3 class='text-lg font-semibold mb-4'>About</h3>
        <p class='text-gray-900 dark:text-white'>
          Just a laid-back software engineer who loves automating boring stuff,
          diving into data, and poking around APIs to make cool things happen.
          Living the Windows/Linux/Mac life because one OS is never enough. Made
          by Toppy with ☕️ and occasional bursts of energy.
        </p>
      </div>

      <!-- Links Section -->
      <div>
        <h3 class='text-lg font-semibold mb-4'>Links</h3>
        <ul class='space-y-2'>
          <!-- Blog link -->
          <li>
            <a
              href='/blog'
              class='text-gray-900 dark:text-white dark:hover:text-white transition-colors'
            >
              Blog
            </a>
          </li>
        </ul>
      </div>

      <!-- Social Section -->
      <div>
        <h3 class='text-lg font-semibold mb-4'>Connect</h3>
        <div class='flex space-x-4'>
          <!-- GitHub link with icon -->
          <a
            href='https://github.com/topkoong'
            target='_blank'
            rel='noopener noreferrer'
            class='text-gray-900 dark:text-white hover:text-purple-600 dark:hover:text-purple-400 transition-colors'
          >
            <span class='sr-only'>GitHub</span>
            <svg class='h-6 w-6' fill='currentColor' viewBox='0 0 24 24'>
              <path
                d='M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z'
              ></path>
            </svg>
          </a>
          
          <!-- X/Twitter link with icon -->
          <a
            href='https://x.com/toptheerut'
            target='_blank'
            rel='noopener noreferrer'
            class='text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors'
          >
            <span class='sr-only'>Twitter</span>
            <svg class='h-6 w-6' fill='currentColor' viewBox='0 0 24 24'>
              <path
                d='M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z'
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright notice -->
    <div class='mt-8 pt-8 border-t border-gray-800 text-center text-gray-400'>
      <p>&copy; {currentYear} Your Name. All rights reserved.</p>
    </div>
  </div>
</footer>
