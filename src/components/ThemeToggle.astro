---
/**
 * Theme Toggle Component
 * 
 * This component provides a button for switching between dark and light themes.
 * It includes:
 * - Sun and moon icons that toggle visibility
 * - localStorage persistence for theme preference
 * - Smooth transitions between themes
 * - Accessible button with proper ARIA labels
 * 
 * Features:
 * - Visual feedback with icon changes
 * - Persistent theme selection
 * - Smooth color transitions
 * - Accessible design with screen reader support
 * - Robust error handling
 * 
 * @fileoverview Theme toggle button with icon switching
 */

// Theme toggle component for switching between dark and light modes
---

<!-- 
  Theme Toggle Button Template
  
  This template creates a theme toggle button with:
  - Sun icon (visible in light mode)
  - Moon icon (visible in dark mode)
  - Proper accessibility attributes
  - Hover effects and transitions
-->
<button
  id='theme-toggle'
  class='rounded-lg p-2 text-gray-400 hover:text-white transition-colors'
  aria-label='Toggle theme'
>
  {/* Sun icon - Visible in light mode only */}
  <svg
    id='sun-icon'
    class='w-5 h-5 hidden'
    fill='none'
    viewBox='0 0 24 24'
    stroke='currentColor'
  >
    <path
      stroke-linecap='round'
      stroke-linejoin='round'
      stroke-width='2'
      d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
    ></path>
  </svg>

  {/* Moon icon - Visible in dark mode only */}
  <svg
    id='moon-icon'
    class='w-5 h-5'
    fill='none'
    viewBox='0 0 24 24'
    stroke='currentColor'
  >
    <path
      stroke-linecap='round'
      stroke-linejoin='round'
      stroke-width='2'
      d='M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z'
    ></path>
  </svg>
</button>

<!-- 
  Theme Toggle JavaScript
  
  This script handles:
  - Theme detection and application
  - Icon visibility switching
  - localStorage persistence
  - Click event handling
  - Error handling for missing elements
-->
<script>
  /**
   * Initialize the theme toggle functionality
   * Sets up event listeners and applies the current theme
   */
  function initThemeToggle() {
    // Get DOM elements
    const toggleButton = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');

    // Check if all required elements exist
    if (!toggleButton || !sunIcon || !moonIcon) {
      console.log('Theme toggle elements not found');
      return;
    }

    // Get current theme from localStorage or default to dark
    const currentTheme = localStorage.getItem('theme') || 'dark';

    // Apply current theme on page load
    if (currentTheme === 'light') {
      document.documentElement.classList.remove('dark');
      sunIcon.classList.remove('hidden');
      moonIcon.classList.add('hidden');
    } else {
      document.documentElement.classList.add('dark');
      sunIcon.classList.add('hidden');
      moonIcon.classList.remove('hidden');
    }

    // Add click event listener for theme switching
    toggleButton.addEventListener('click', function () {
      const isDark = document.documentElement.classList.contains('dark');

      if (isDark) {
        // Switch to light mode
        document.documentElement.classList.remove('dark');
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
        localStorage.setItem('theme', 'light');
      } else {
        // Switch to dark mode
        document.documentElement.classList.add('dark');
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
        localStorage.setItem('theme', 'dark');
      }
    });
  }

  // Initialize theme toggle when DOM is ready
  // Handle both cases: DOM already loaded or still loading
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }
</script>
