---
// Layout specifically for blog post markdown files
import Layout from './Layout.astro';
// Get frontmatter from markdown file
const { frontmatter } = Astro.props;

// Format dates for SEO
const publishedTime = new Date(frontmatter.date).toISOString();
const modifiedTime = frontmatter.modified
  ? new Date(frontmatter.modified).toISOString()
  : publishedTime;

// Generate article-specific keywords
const articleKeywords = frontmatter.tags ? frontmatter.tags.join(', ') : '';
const allKeywords = `software engineer, full-stack development, automation, tutorials, blog, programming, web development${articleKeywords ? ', ' + articleKeywords : ''}`;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  type='article'
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  keywords={allKeywords}
>
  <article class='max-w-5xl mx-auto'>
    <header class='mb-12'>
      <div class='animate-fade-in-up'>
        <h1
          class='text-5xl font-bold text-gray-900 dark:text-white mb-6 leading-tight'
        >
          {frontmatter.title}
        </h1>
        <div
          class='flex items-center space-x-4 text-gray-600 dark:text-gray-400'
        >
          <time class='text-lg' datetime={publishedTime}>
            {
              new Date(frontmatter.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </time>
          <div class='w-2 h-2 bg-purple-500 rounded-full'></div>
          <span class='text-lg'>Theeruttop (Toppy)</span>
        </div>
        {
          frontmatter.tags && (
            <div class='mt-6 flex flex-wrap gap-2'>
              {frontmatter.tags.map((tag: string) => (
                <span class='px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300 rounded-full text-sm font-medium'>
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </header>
    {/* Apply Tailwind Typography to markdown content */}
    <div
      class='prose prose-gray dark:prose-invert max-w-none
      prose-headings:text-gray-900 dark:prose-headings:text-white
      prose-p:text-gray-700 dark:prose-p:text-gray-300
      prose-a:text-blue-600 dark:prose-a:text-blue-400
      prose-strong:text-gray-900 dark:prose-strong:text-white
      prose-blockquote:border-gray-200 dark:prose-blockquote:border-gray-700
      prose-blockquote:text-gray-600 dark:prose-blockquote:text-gray-400
      prose-ul:text-gray-700 dark:prose-ul:text-gray-300
      prose-ol:text-gray-700 dark:prose-ol:text-gray-300
      prose-li:text-gray-700 dark:prose-li:text-gray-300
      prose-hr:border-gray-200 dark:prose-hr:border-gray-700
      prose-table:border-gray-200 dark:prose-table:border-gray-700
      prose-th:border-gray-200 dark:prose-th:border-gray-700
      prose-td:border-gray-200 dark:prose-td:border-gray-700'
    >
      <slot />
      {/* Rendered markdown content goes here */}
    </div>
  </article>
</Layout>

<script>
  // Initialize Mermaid when the page loads
  // Initialize Mermaid when the page loads
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const mermaid = await import('mermaid');

      // Function to configure and initialize Mermaid
      const initializeMermaid = () => {
        const isDarkMode = document.documentElement.classList.contains('dark');

        mermaid.default.initialize({
          startOnLoad: false,
          theme: isDarkMode ? 'dark' : 'default',
          securityLevel: 'loose',
          fontFamily: 'system-ui, -apple-system, sans-serif',
          fontSize: 16,
          flowchart: {
            useMaxWidth: true,
            htmlLabels: true,
            curve: 'basis',
            nodeSpacing: 50,
            rankSpacing: 50,
          },
          themeVariables: isDarkMode
            ? {
                // Dark mode theme variables
                darkMode: true,
                background: '#1f2937',
                primaryColor: '#374151',
                primaryTextColor: '#ffffff',
                primaryBorderColor: '#9ca3af',
                lineColor: '#d1d5db',
                secondaryColor: '#1f2937',
                tertiaryColor: '#111827',
                mainBkg: '#374151',
                secondBkg: '#1f2937',
                textColor: '#ffffff',
                border1: '#9ca3af',
                border2: '#6b7280',
                arrowheadColor: '#d1d5db',
                fontFamily: 'system-ui, -apple-system, sans-serif',
                fontSize: '16px',
                labelTextColor: '#ffffff',
                nodeTextColor: '#ffffff',
                clusterBkg: '#374151',
                clusterBorder: '#9ca3af',
                defaultLinkColor: '#d1d5db',
                edgeLabelBackground: '#1f2937',
              }
            : {
                // Light mode theme variables
                darkMode: false,
                primaryColor: '#e0f2fe',
                primaryTextColor: '#000000',
                primaryBorderColor: '#0277bd',
                lineColor: '#424242',
                secondaryColor: '#fce4ec',
                tertiaryColor: '#e0f7fa',
                background: '#ffffff',
                mainBkg: '#e0f2fe',
                secondBkg: '#fce4ec',
                textColor: '#000000',
                fontSize: '16px',
                fontFamily: 'system-ui, -apple-system, sans-serif',
              },
        });
      };

      // Initial setup
      initializeMermaid();

      // Wait for DOM to be ready
      setTimeout(() => {
        const mermaidContainers = document.querySelectorAll('.mermaid');

        mermaidContainers.forEach((container, index) => {
          if (container.textContent && container.textContent.trim()) {
            // CRITICAL FIX: Ensure each container has a unique ID
            if (!container.id) {
              container.id = `mermaid-diagram-${Date.now()}-${index}`;
            }

            try {
              // Render only this specific container
              mermaid.default.run({
                nodes: [container as HTMLElement],
              });

              // Force dark backgrounds and white text after render
              setTimeout(() => {
                if (document.documentElement.classList.contains('dark')) {
                  // Map of light colors to dark colors
                  const colorMap: Record<string, string> = {
                    '#e0f2fe': '#1e3a8a',
                    '#fce4ec': '#881337',
                    '#e3f2fd': '#1e40af',
                    '#e0f7fa': '#115e59',
                    '#ffebee': '#991b1b',
                    '#fff3e0': '#92400e',
                    '#e8f5e8': '#14532d',
                    '#f3e5f5': '#581c87',
                  };

                  // Change node background colors
                  container
                    .querySelectorAll(
                      '.node rect, .node circle, .node ellipse, .node polygon'
                    )
                    .forEach((el) => {
                      const htmlEl = el as HTMLElement;
                      const currentFill = htmlEl
                        .getAttribute('style')
                        ?.match(/fill:\s*(#[a-fA-F0-9]{6})/)?.[1]
                        ?.toLowerCase();
                      if (currentFill && colorMap[currentFill]) {
                        htmlEl.style.fill = colorMap[currentFill];
                      }
                    });

                  // Force white text in foreignObject elements
                  container
                    .querySelectorAll(
                      'foreignObject div, foreignObject span, foreignObject p'
                    )
                    .forEach((el) => {
                      const htmlEl = el as HTMLElement;
                      htmlEl.style.color = '#ffffff';
                      htmlEl.style.fontWeight = '600';
                      htmlEl.style.textShadow = 'none';
                      htmlEl.style.webkitFontSmoothing = 'antialiased';
                    });

                  // Fix foreignObject width to prevent text cutoff
                  container.querySelectorAll('foreignObject').forEach((fo) => {
                    const currentWidth = parseFloat(
                      fo.getAttribute('width') || '0'
                    );
                    if (currentWidth) {
                      fo.setAttribute('width', (currentWidth * 1.2).toString());
                    }
                  });
                }
              }, 100);
            } catch (error) {
              console.error('Error rendering Mermaid diagram:', error);
            }
          }
        });
      }, 100);

      // Listen for theme changes
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (
            mutation.type === 'attributes' &&
            mutation.attributeName === 'class'
          ) {
            initializeMermaid();

            setTimeout(() => {
              // Remove all existing SVGs
              document.querySelectorAll('.mermaid svg').forEach((svg) => {
                svg.remove();
              });

              // Reset all containers
              const mermaidContainers = document.querySelectorAll('.mermaid');
              mermaidContainers.forEach((container, index) => {
                // Reset processed state
                if (container.getAttribute('data-processed')) {
                  container.removeAttribute('data-processed');
                }

                // Ensure unique ID
                if (!container.id) {
                  container.id = `mermaid-diagram-${Date.now()}-${index}`;
                }

                try {
                  // Re-render this specific container
                  mermaid.default.run({
                    nodes: [container as HTMLElement],
                  });

                  // Force dark backgrounds and white text after re-render
                  setTimeout(() => {
                    if (document.documentElement.classList.contains('dark')) {
                      const colorMap: Record<string, string> = {
                        '#e0f2fe': '#1e3a8a',
                        '#fce4ec': '#881337',
                        '#e3f2fd': '#1e40af',
                        '#e0f7fa': '#115e59',
                        '#ffebee': '#991b1b',
                        '#fff3e0': '#92400e',
                        '#e8f5e8': '#14532d',
                        '#f3e5f5': '#581c87',
                      };

                      container
                        .querySelectorAll(
                          '.node rect, .node circle, .node ellipse, .node polygon'
                        )
                        .forEach((el) => {
                          const htmlEl = el as HTMLElement;
                          const currentFill = htmlEl
                            .getAttribute('style')
                            ?.match(/fill:\s*(#[a-fA-F0-9]{6})/)?.[1]
                            ?.toLowerCase();
                          if (currentFill && colorMap[currentFill]) {
                            htmlEl.style.fill = colorMap[currentFill];
                          }
                        });

                      container
                        .querySelectorAll(
                          'foreignObject div, foreignObject span, foreignObject p'
                        )
                        .forEach((el) => {
                          const htmlEl = el as HTMLElement;
                          htmlEl.style.color = '#ffffff';
                          htmlEl.style.fontWeight = '600';
                          htmlEl.style.textShadow = 'none';
                          htmlEl.style.webkitFontSmoothing = 'antialiased';
                        });
                    }
                  }, 100);
                } catch (error) {
                  console.error('Error re-rendering Mermaid diagram:', error);
                }
              });
            }, 50);
          }
        });
      });

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      });
    } catch (error) {
      console.error('Failed to load Mermaid:', error);
    }
  });
</script>

